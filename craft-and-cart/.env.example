# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# --- Database ---------------------------------------------------------------
# Local development: the built-in PostgreSQL started by `npm run db:start` (port 54329).
DATABASE_URL=postgres://craftcart:craftcart_local@localhost:54329/craftcart
# Set to true for hosted databases that require SSL.
DATABASE_SSL=false

# --- Security ---------------------------------------------------------------
# Secret used to sign login cookies. REQUIRED in production; use a long random string (40+ characters).
JWT_SECRET=change-me-to-a-long-random-string

# Admin account created by `npm run db:seed` / `npm run db:setup`.
ADMIN_EMAIL=admin@craftandcart.local
# Optional locally (a demo default is used); REQUIRED, 10+ characters, when seeding an online database.
ADMIN_PASSWORD=

# --- Site address -----------------------------------------------------------
# Used in password-reset emails. Use your real https address when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Razorpay payments (leave blank to offer Cash on Delivery only) ----------------------
# Use the rzp_test_ keys from Razorpay Dashboard -> API Keys while testing. Secret stays server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# You choose this; use the same value on the webhook in the Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=

# --- Email for "Forgot password" (optional; locally the reset link is printed in the server console) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=