# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# --- Database ---------------------------------------------------------------
# Local development: the built-in PostgreSQL started by `npm run db:start` (port 54329).
DATABASE_URL=postgres://craftcart:craftcart_local@localhost:54329/craftcart
# Set to true for hosted databases that require SSL.
DATABASE_SSL=false

# --- Security ---------------------------------------------------------------
# Secret used to sign login cookies. REQUIRED in production; use a long random string (40+ characters).
JWT_SECRET=change-me-to-a-long-random-string

# Admin account created by `npm run db:seed` / `npm run db:setup`.
ADMIN_EMAIL=admin@craftandcart.local
# Optional locally (a demo default is used); REQUIRED, 10+ characters, when seeding an online database.
ADMIN_PASSWORD=

# --- Site address -----------------------------------------------------------
# Where PhonePe sends customers back to. Use your real https address when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- PhonePe payments (leave blank to run online payment in local demo mode) --
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# You choose these two; use the same values on the webhook in the PhonePe dashboard.
PHONEPE_WEBHOOK_USER=
PHONEPE_WEBHOOK_PASS=
