# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database and logs (never upload)
/.pgdata/
.pg.log
.pg.err
.dev.log
.dev.err
.prod.log
.prod.err
.dev2.log
.dev2.err

# Python leftovers and virtual environments (never upload)
venv/
.venv/
__pycache__/
*.py[cod]
*.sqlite3
.env
.env.*
*.key
