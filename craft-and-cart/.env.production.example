# Production settings for the VPS Docker stack (docker-compose.production.yml).
#
# On the server:   cp .env.production.example .env.production   &&   chmod 600 .env.production
# Then fill in the two REQUIRED values below. Never commit .env.production.

# ---- REQUIRED ---------------------------------------------------------------------------------
# Password of the PostgreSQL database. Use letters and digits only (it is placed inside a URL):
#   openssl rand -hex 24
CRAFT_DB_PASSWORD=

# Secret that signs login cookies. At least 32 characters, random, kept private:
#   openssl rand -hex 32
JWT_SECRET=

# ---- Fixed by the compose file (shown here for reference; no need to set) ----------------------
# NEXT_PUBLIC_SITE_URL=https://craft.jilljill.in
# Database host/port are internal: craft-db:5432 on the private "craft_net" network (not published).

# ---- OPTIONAL: PhonePe online payments (leave empty to use Cash on Delivery only) ----------------
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# You choose these two; use the same values on the webhook in the PhonePe dashboard.
PHONEPE_WEBHOOK_USER=
PHONEPE_WEBHOOK_PASS=
