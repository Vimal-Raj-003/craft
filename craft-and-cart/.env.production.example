# Production settings for the VPS Docker stack (docker-compose.production.yml).
#
# On the server:   cp .env.production.example .env.production   &&   chmod 600 .env.production
# Then fill in the two REQUIRED values below. Never commit .env.production.

# ---- REQUIRED ---------------------------------------------------------------------------------
# Password of the PostgreSQL database. Use letters and digits only (it is placed inside a URL):
#   openssl rand -hex 24
CRAFT_DB_PASSWORD=

# Secret that signs login cookies. At least 32 characters, random, kept private:
#   openssl rand -hex 32
JWT_SECRET=

# ---- Fixed by the compose file (shown here for reference; no need to set) ----------------------
# NEXT_PUBLIC_SITE_URL=https://craft.jilljill.in
# Database host/port are internal: craft-db:5432 on the private "craft_net" network (not published).

# ---- Razorpay online payments (leave empty to offer Cash on Delivery only) ----------------------
# Razorpay Dashboard -> Account & Settings -> API Keys. Use the rzp_test_ pair while testing (Test Mode),
# then the rzp_live_ pair. The Key Secret stays on the server and is never sent to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# You choose this secret; enter the SAME value when you add the webhook in the Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ---- OPTIONAL: email for "Forgot password" (without it the reset link is not sent) --------------
# Any SMTP mailbox, e.g. a Hostinger email account (smtp.hostinger.com, port 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=